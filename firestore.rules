rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check user role from metadata doc
    function hasRole(role) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    // Check if user is inside any of these roles
    function hasAnyRole(roles) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin');
    }
    
    // Orders collection rules
    match /orders/{orderId} {
      allow read, write: if hasAnyRole(['waiter', 'chef', 'cashier', 'manager', 'admin']);
    }
    
    // Bills collection rules
    match /bills/{billId} {
      allow read, write: if hasAnyRole(['cashier', 'manager', 'admin']);
    }
    
    // Menu items
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if hasAnyRole(['manager', 'admin']);
    }
    
    // Activity logs
    match /activityLogs/{logId} {
      allow read: if hasAnyRole(['manager', 'admin']);
      allow write: if isAuthenticated();
    }
  }
}
